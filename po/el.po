msgstr "Η σύνδεση δεν είναι διαθέσιμη."

#: satellite/plugins/clipboard/__init__.py:36
msgid "Send clipboard"
msgstr "Αποστολή προχείρου"

#: satellite/plugins/clipboard/__init__.py:37
msgid "Send the current clipboard text to this device"
msgstr "Αποστολή του κειμένου του προχείρου σε αυτή τη συσκευή"

#: satellite/plugins/connectivity_report/__init__.py:17
