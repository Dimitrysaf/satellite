#: satellite/desktop_input.py:185
msgid "To type letters outside the US keyboard (such as Greek), install wl-clipboard: sudo apt install wl-clipboard"
msgstr "Για να πληκτρολογείτε γράμματα εκτός του αμερικανικού πληκτρολογίου (όπως ελληνικά), εγκαταστήστε το wl-clipboard: sudo apt install wl-clipboard"

#: satellite/desktop_input.py:412
msgid "Remote control of this computer wasn't allowed. Satellite will ask again in a minute; allow it there to use the phone as a touchpad."
msgstr "Ο απομακρυσμένος έλεγχος αυτού του υπολογιστή δεν επιτράπηκε. Το Satellite θα ρωτήσει ξανά σε ένα λεπτό· επιτρέψτε τον εκεί για να χρησιμοποιείτε το τηλέφωνο ως επιφάνεια αφής."

#: satellite/desktop_input.py:414
msgid "ydotool isn't working. Start its service (ydotoold) and make sure you may use /dev/uinput."
msgstr "Το ydotool δεν λειτουργεί. Ξεκινήστε την υπηρεσία του (ydotoold) και βεβαιωθείτε ότι έχετε πρόσβαση στο /dev/uinput."

#: satellite/desktop_input.py:421
msgid "This Wayland desktop offers no remote control permission. Install ydotool and start its ydotoold service: sudo apt install ydotool"
msgstr "Αυτή η επιφάνεια εργασίας Wayland δεν προσφέρει άδεια απομακρυσμένου ελέγχου. Εγκαταστήστε το ydotool και ξεκινήστε την υπηρεσία ydotoold: sudo apt install ydotool"

#: satellite/desktop_input.py:423
msgid "Install xdotool: sudo apt install xdotool"
msgstr "Εγκαταστήστε το xdotool: sudo apt install xdotool"

#: satellite/desktop_input.py:434
msgid "{} failed: {}"
msgstr "Το {} απέτυχε: {}"

#: satellite/desktop_input.py:440
msgid "Nothing can control this computer yet. "
msgstr "Τίποτα δεν μπορεί να ελέγξει ακόμα αυτόν τον υπολογιστή. "

#: satellite/desktop_input.py:442
msgid "Using xdotool (X11)."
msgstr "Χρησιμοποιείται το xdotool (X11)."

#: satellite/desktop_input.py:444
msgid "Using the desktop's remote control permission (Wayland)."
msgstr "Χρησιμοποιείται η άδεια απομακρυσμένου ελέγχου της επιφάνειας εργασίας (Wayland)."

#: satellite/desktop_input.py:445
msgid "Using ydotool (Wayland)."
msgstr "Χρησιμοποιείται το ydotool (Wayland)."

#: satellite/desktop_input.py:447
msgid "Its ydotoold service doesn't seem to be running."
msgstr "Η υπηρεσία ydotoold του δεν φαίνεται να εκτελείται."

#: satellite/desktop_input.py:449
msgid "Install wl-clipboard to type letters outside the US keyboard."
msgstr "Εγκαταστήστε το wl-clipboard για να πληκτρολογείτε γράμματα εκτός του αμερικανικού πληκτρολογίου."

#: satellite/plugins/battery/__init__.py:29
msgid "Battery"
msgstr "Μπαταρία"

#: satellite/plugins/battery/__init__.py:30
msgid "Show the paired device's battery, and share this computer's battery with it."
msgstr "Εμφάνιση της μπαταρίας της συνδεδεμένης συσκευής και κοινή χρήση της μπαταρίας αυτού του υπολογιστή μαζί της."

#: satellite/plugins/battery/__init__.py:35
msgid "Warn when the device battery is low"
msgstr "Προειδοποίηση όταν η μπαταρία της συσκευής είναι χαμηλή"

#: satellite/plugins/battery/__init__.py:36
msgid "Share this computer's battery"
msgstr "Κοινή χρήση της μπαταρίας αυτού του υπολογιστή"

#: satellite/plugins/battery/__init__.py:115
msgid "{} battery is low"
msgstr "Χαμηλή μπαταρία: {}"

#: satellite/plugins/battery/__init__.py:117
#, no-python-format
msgid "{}% remaining. Plug it in soon."
msgstr "Απομένει {}%. Συνδέστε τη σύντομα στον φορτιστή."

#: satellite/plugins/clipboard/__init__.py:12
msgid "Clipboard"
msgstr "Πρόχειρο"

#: satellite/plugins/clipboard/__init__.py:13
msgid "Copy on one device, paste on the other."
msgstr "Αντιγραφή στη μία συσκευή, επικόλληση στην άλλη."

#: satellite/plugins/clipboard/__init__.py:19
msgid "Receive clipboard updates"
msgstr "Λήψη ενημερώσεων του προχείρου"

#: satellite/plugins/clipboard/__init__.py:20
msgid "Send this computer's clipboard automatically"
msgstr "Αυτόματη αποστολή του προχείρου αυτού του υπολογιστή"

#: satellite/plugins/clipboard/__init__.py:21
msgid "Including passwords (as marked by password managers)"
msgstr "Μαζί με κωδικούς πρόσβασης (όπως τους σημειώνουν οι διαχειριστές κωδικών)"

#: satellite/plugins/clipboard/__init__.py:29
msgid "Clipboard is empty"
msgstr "Το πρόχειρο είναι κενό"

#: satellite/plugins/clipboard/__init__.py:29
msgid "Copy some text first, then send it."
msgstr "Αντιγράψτε πρώτα κάποιο κείμενο και μετά στείλτε το."

#: satellite/plugins/clipboard/__init__.py:33
msgid "Could not send the clipboard"
msgstr "Δεν ήταν δυνατή η αποστολή του προχείρου"

#: satellite/plugins/clipboard/__init__.py:33
#: satellite/plugins/sftp/__init__.py:65
#: satellite/plugins/share/__init__.py:381
