msgid "Contacts"
msgstr "Επαφές"

#: satellite/plugins/contacts/__init__.py:51
msgid "Keep a copy of the paired phone's contacts on this computer."
msgstr "Διατήρηση αντιγράφου των επαφών του συνδεδεμένου τηλεφώνου σε αυτόν τον υπολογιστή."

#: satellite/plugins/contacts/__init__.py:62
msgid "Copy the phone's contacts to this computer"
msgstr "Αντιγραφή των επαφών του τηλεφώνου σε αυτόν τον υπολογιστή"

#: satellite/plugins/contacts/__init__.py:64
msgid "Share them with other address book apps (GNOME Contacts, Evolution, ...)"
msgstr "Κοινή χρήση τους με άλλες εφαρμογές επαφών (Επαφές GNOME, Evolution, ...)"

#: satellite/plugins/contacts/__init__.py:66
msgid "Also share them with KDE apps"
msgstr "Κοινή χρήση τους και με εφαρμογές του KDE"

#: satellite/plugins/contacts/__init__.py:184
msgid "Could not open Contacts"
msgstr "Δεν ήταν δυνατό το άνοιγμα των Επαφών"

#: satellite/plugins/contacts/__init__.py:184
msgid "Satellite Contacts is not installed."
msgstr "Οι Επαφές Satellite δεν είναι εγκατεστημένες."

#: satellite/plugins/contacts/__init__.py:187
msgid "See the phone's contacts"
msgstr "Προβολή των επαφών του τηλεφώνου"

#: satellite/plugins/digitizer/__init__.py:26
msgid "Drawing works as a mouse, without pen pressure: Satellite may not create a virtual drawing tablet yet. Log out and back in after installing Satellite (its udev rule gives you access to /dev/uinput)."
msgstr "Η σχεδίαση λειτουργεί ως ποντίκι, χωρίς πίεση γραφίδας: το Satellite δεν μπορεί ακόμα να δημιουργήσει εικονική ταμπλέτα σχεδίασης. Αποσυνδεθείτε και συνδεθείτε ξανά μετά την εγκατάσταση του Satellite (ο κανόνας udev του σας δίνει πρόσβαση στο /dev/uinput)."

#: satellite/plugins/digitizer/__init__.py:111
msgid "Drawing tablet"
msgstr "Ταμπλέτα σχεδίασης"

#: satellite/plugins/digitizer/__init__.py:112
msgid "Draw on this computer on the device's screen, with a pen or a finger."
msgstr "Σχεδιάστε σε αυτόν τον υπολογιστή πάνω στην οθόνη της συσκευής, με γραφίδα ή με το δάχτυλο."

#: satellite/plugins/digitizer/__init__.py:118
msgid "Draw as"
msgstr "Σχεδίαση ως"

#: satellite/plugins/digitizer/__init__.py:119
msgid "A drawing tablet with pen pressure, if possible"
msgstr "Ταμπλέτα σχεδίασης με πίεση γραφίδας, αν είναι δυνατό"

#: satellite/plugins/digitizer/__init__.py:120
msgid "The mouse (no pressure, works in every app)"
msgstr "Ποντίκι (χωρίς πίεση, λειτουργεί σε κάθε εφαρμογή)"

#: satellite/plugins/digitizer/__init__.py:135
msgid "Drawing apps get pen pressure and the eraser."
msgstr "Οι εφαρμογές σχεδίασης λαμβάνουν την πίεση της γραφίδας και τη γόμα."

#: satellite/plugins/digitizer/__init__.py:182
msgid "Drawing without pen pressure"
msgstr "Σχεδίαση χωρίς πίεση γραφίδας"

#: satellite/plugins/lock/__init__.py:31
msgid "Lock"
msgstr "Κλείδωμα"

#: satellite/plugins/lock/__init__.py:32
msgid "Lock this computer from the paired device, and show whether the device is locked."
msgstr "Κλείδωμα αυτού του υπολογιστή από τη συνδεδεμένη συσκευή και εμφάνιση του αν η συσκευή είναι κλειδωμένη."

#: satellite/plugins/lock/__init__.py:38
msgid "Allow this device to unlock the computer"
msgstr "Να επιτρέπεται σε αυτή τη συσκευή να ξεκλειδώνει τον υπολογιστή"

#: satellite/plugins/lock/__init__.py:73
msgid "Locked"
msgstr "Κλειδωμένη"

#: satellite/plugins/lock/__init__.py:74
msgid "Unlocked"
msgstr "Ξεκλείδωτη"

#: satellite/plugins/mousepad/__init__.py:181
msgid "The phone can't control this computer"
msgstr "Το τηλέφωνο δεν μπορεί να ελέγξει αυτόν τον υπολογιστή"

#: satellite/plugins/mousepad/__init__.py:188
msgid "Mouse and keyboard"
msgstr "Ποντίκι και πληκτρολόγιο"

#: satellite/plugins/mousepad/__init__.py:189
msgid "Use the paired device as a touchpad and keyboard."
msgstr "Χρήση της συνδεδεμένης συσκευής ως επιφάνειας αφής και πληκτρολογίου."

#: satellite/plugins/mousepad/__init__.py:198
msgid "Swap left and right buttons"
msgstr "Αντιμετάθεση αριστερού και δεξιού κουμπιού"

#: satellite/plugins/mpris/__init__.py:30
msgid "Media player control"
msgstr "Έλεγχος αναπαραγωγής πολυμέσων"

#: satellite/plugins/mpris/__init__.py:31
msgid "Show and control the device's music and videos from this desktop."
msgstr "Εμφάνιση και έλεγχος της μουσικής και των βίντεο της συσκευής από αυτή την επιφάνεια εργασίας."

#: satellite/plugins/mpris/__init__.py:37
msgid "Show album art from the device"
msgstr "Εμφάνιση εξωφύλλων από τη συσκευή"

#: satellite/plugins/mpriscontrol/__init__.py:132
msgid "Control media on this computer"
msgstr "Έλεγχος πολυμέσων σε αυτόν τον υπολογιστή"

#: satellite/plugins/mpriscontrol/__init__.py:133
msgid "Play, pause and skip this computer's music and videos from the paired device."
msgstr "Αναπαραγωγή, παύση και παράλειψη της μουσικής και των βίντεο αυτού του υπολογιστή από τη συνδεδεμένη συσκευή."

#: satellite/plugins/mpriscontrol/__init__.py:138
msgid "Send album art to the device"
msgstr "Αποστολή εξωφύλλων στη συσκευή"

#: satellite/plugins/notifications/__init__.py:34
msgid "Notification"
msgstr "Ειδοποίηση"

#: satellite/plugins/notifications/__init__.py:60
msgid "Notifications"
msgstr "Ειδοποιήσεις"

#: satellite/plugins/notifications/__init__.py:61
msgid "Show the paired device's notifications on this computer."
msgstr "Εμφάνιση των ειδοποιήσεων της συνδεδεμένης συσκευής σε αυτόν τον υπολογιστή."

#: satellite/plugins/notifications/__init__.py:71
msgid "Show notifications from this device"
msgstr "Εμφάνιση ειδοποιήσεων από αυτή τη συσκευή"

#: satellite/plugins/notifications/__init__.py:72
msgid "Also show the ones already on the device when it connects (quietly)"
msgstr "Εμφάνιση και όσων υπάρχουν ήδη στη συσκευή όταν συνδέεται (αθόρυβα)"

#: satellite/plugins/notifications/__init__.py:74
msgid "Show notification text (turn off for privacy)"
msgstr "Εμφάνιση του κειμένου των ειδοποιήσεων (απενεργοποιήστε το για ιδιωτικότητα)"

#: satellite/plugins/notifications/__init__.py:75
msgid "Show app icons and pictures"
msgstr "Εμφάνιση εικονιδίων εφαρμογών και εικόνων"

#: satellite/plugins/notifications/__init__.py:76
msgid "Offer Reply on notifications that allow it"
msgstr "Επιλογή Απάντησης στις ειδοποιήσεις που το επιτρέπουν"

#: satellite/plugins/notifications/__init__.py:77
msgid "Dismissing a notification here dismisses it on the device"
msgstr "Η απόρριψη μιας ειδοποίησης εδώ την απορρίπτει και στη συσκευή"

#: satellite/plugins/notifications/__init__.py:79
msgid "Offer to copy verification codes"
msgstr "Επιλογή αντιγραφής κωδικών επαλήθευσης"

#: satellite/plugins/notifications/__init__.py:136
#: satellite/plugins/notifications/__init__.py:161
msgid "Reply in {}"
msgstr "Απάντηση στο {}"

#: satellite/plugins/notifications/__init__.py:136
msgid "Reply to {}"
msgstr "Απάντηση σε {}"

#: satellite/plugins/notifications/__init__.py:138
msgid "Your reply goes out from {} on {}."
msgstr "Η απάντησή σας θα σταλεί από το {} στη συσκευή {}."

#: satellite/plugins/notifications/__init__.py:149
msgid "New notification on {}"
msgstr "Νέα ειδοποίηση στη συσκευή {}"

#: satellite/plugins/notifications/__init__.py:161
msgid "Reply"
msgstr "Απάντηση"

#: satellite/plugins/notifications/__init__.py:165
msgid "Copy {}"
msgstr "Αντιγραφή {}"

#: satellite/plugins/pausemusic/__init__.py:79
msgid "Pause music during calls"
msgstr "Παύση μουσικής κατά τις κλήσεις"

#: satellite/plugins/pausemusic/__init__.py:80
msgid "Pause media or mute the sound when the paired phone rings, and restore it afterwards."
msgstr "Παύση των πολυμέσων ή σίγαση του ήχου όταν χτυπά το συνδεδεμένο τηλέφωνο και επαναφορά τους μετά."

#: satellite/plugins/pausemusic/__init__.py:85
msgid "Wait until the call is answered"
msgstr "Αναμονή μέχρι να απαντηθεί η κλήση"

#: satellite/plugins/pausemusic/__init__.py:86
msgid "Pause media players"
msgstr "Παύση των προγραμμάτων αναπαραγωγής"

#: satellite/plugins/pausemusic/__init__.py:87
msgid "Mute system sound"
msgstr "Σίγαση του ήχου του συστήματος"

#: satellite/plugins/pausemusic/__init__.py:88
msgid "Resume automatically when the call ends"
msgstr "Αυτόματη συνέχιση όταν τελειώσει η κλήση"

#: satellite/plugins/ping/__init__.py:11 satellite/plugins/ping/__init__.py:51
msgid "Ping"
msgstr "Ping"

